#!/bin/bash
# ==============================================================================
#  k50-image —— 镜像模式管理工具（在设备上跑）
#
#  镜像模式：只读 squashfs 系统层 + /data 上的可写 overlay。
#  换系统 = 换一个 squashfs 文件 + 重启，不再刷 userdata，不再丢数据。
#
#  正常启动时由 image-mode/pivot（占着 /sbin/init）组装这两个层；
#  本工具负责装镜像、切镜像、回滚、看状态、清理旧镜像。
# ==============================================================================
set -euo pipefail

IMAGES=${K50_IMAGES:-/images}
DATA=${K50_DATA:-/data}
MARKER="$IMAGES/enabled"
CURRENT="$IMAGES/system-current"
UPPER="$DATA/upper"
WORK="$DATA/work"
KEEP_DEFAULT=3

die() { printf '\033[31m错误：\033[0m%s\n' "$*" >&2; exit 1; }
info() { printf '\033[36m==>\033[0m %s\n' "$*"; }
ok() { printf '\033[32m  ✓\033[0m %s\n' "$*"; }
warn() { printf '\033[33m  ! \033[0m %s\n' "$*"; }

need_root() { [ "$(id -u)" = 0 ] || die "需要 root（sudo $0 $*）"; }

human() { numfmt --to=iec-i --suffix=B "$1" 2>/dev/null || echo "$1"; }

is_bootstrap() {
	# 引导层在 ext4 上：/ 不是 overlay
	! grep -q ' / overlay ' /proc/mounts
}

running_image() {
	# 从挂载参数里抓出 lowerdir 的镜像名
	awk '/^overlay \/ overlay /{ if (match($0, /lowerdir=[^,]*/)) { print substr($0, RSTART+9, RLENGTH-9); exit } }' /proc/mounts 2>/dev/null
}

sha_of() { sha256sum "$1" | awk '{print $1}'; }

# 镜像里是否带 image-mode 工具（k50-image 自己）。
# 这条检查是 2026-10-31 真机事故换来的：把一个"不含 k50-image"的镜像当 lower 换上去后，
# 新系统里连切回旧镜像的命令都没有了，只能手工改 $CURRENT 符号链接。
# 返回 0=有  1=明确没有  2=无法判断（没有 unsquashfs）
image_has_tools() {
	command -v unsquashfs >/dev/null 2>&1 || return 2
	# 注意：这里**不能**写 `unsquashfs -l | grep -q`。本脚本开着 pipefail，
	# grep 一旦命中就退出，unsquashfs 收到 SIGPIPE（rc=141），整条管道被判失败，
	# 于是镜像里明明有 k50-image 却返回 1 —— 2026-10-31 真机就是这么被卡住的。
	# 改为先把清单读进变量再判断，没有管道、没有 SIGPIPE。
	local listing
	listing="$(unsquashfs -l "$1" 2>/dev/null || true)"
	case "$listing" in
	*"usr/local/sbin/k50-image"*) return 0 ;;
	esac
	return 1
}

check_squashfs() {
	local f="$1"
	[ -f "$f" ] || die "文件不存在：$f"
	[ "$(dd if="$f" bs=4 count=1 2>/dev/null)" = "hsqs" ] ||
		die "不是 squashfs 镜像（magic 不是 hsqs）：$f"
}

cmd_status() {
	printf '镜像模式：%s\n' "$([ -e "$MARKER" ] && echo '已启用' || echo '未启用（走普通启动）')"
	if is_bootstrap; then
		echo "当前：引导层（ext4 根分区）"
		if [ -e "$MARKER" ]; then
			echo "      重启后会切到镜像模式"
		fi
	else
		echo "当前：镜像模式（已 pivot 进只读系统层 + overlay）"
		local ro; ro="$(running_image)"
		if [ -n "$ro" ]; then
			echo "      只读层：$ro"
		fi
	fi
	if [ -L "$CURRENT" ]; then
		echo "下次启动用：$(basename "$(readlink -f "$CURRENT")")"
	elif [ -e "$CURRENT" ]; then
		echo "下次启动用：$(basename "$CURRENT")"
	elif [ -e "$MARKER" ]; then
		# 预置镜像模式刷完还没装过镜像：pivot 会把引导层自己绑定挂载成只读下层，
		# 改动照样写进 $UPPER，所以重开还是镜像模式，不是退回普通启动。
		echo "下次启动用：（还没有系统镜像 → 首开模式：引导层当只读下层，改动写 $UPPER）"
	else
		echo "下次启动用：（未设置，重启会退回普通启动）"
	fi

	echo
	printf '可写层 %s：' "$UPPER"
	if [ -d "$UPPER" ]; then
		echo "$(human "$(du -sb "$UPPER" 2>/dev/null | awk '{print $1}')")（改动量）"
	else
		echo "不存在"
	fi
	printf '空间：/images %s 可用，/data %s 可用\n' \
		"$(human "$(df -B1 --output=avail "$IMAGES" 2>/dev/null | tail -1)")" \
		"$(human "$(df -B1 --output=avail "$DATA" 2>/dev/null | tail -1)")"

	echo
	cmd_list
}

cmd_list() {
	[ -d "$IMAGES" ] || die "$IMAGES 不存在"
	local n=0 cur="" run=""
	cur="$(basename "$(readlink -f "$CURRENT" 2>/dev/null || echo '')")"
	run="$(running_image)"
	if [ -n "$run" ]; then
		run="$(basename "$run")"
	fi
	shopt -s nullglob
	for f in "$IMAGES"/system-*.squashfs; do
		local base size mark=""
		base="$(basename "$f")"
		size="$(human "$(stat -c%s "$f")")"
		[ "$base" = "$cur" ] && mark=" ← 下次启动"
		[ "$base" = "$run" ] && mark="$mark（正在用）"
		printf '  %-34s %10s%s\n' "$base" "$size" "$mark"
		n=$((n + 1))
	done
	[ "$n" = 0 ] && echo "  （没有镜像）"
	return 0
}

cmd_install() {
	need_root install
	local src="${1:-}"; [ -n "$src" ] || die "用法：k50-image install <文件|URL> [--sha256 <期望值>]"
	shift || true
	local want=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--sha256) want="${2:-}"; shift 2 ;;
			*) die "未知参数：$1" ;;
		esac
	done
	[ -d "$IMAGES" ] || mkdir -p "$IMAGES"

	local tmp="/tmp/k50-image-$$.squashfs"
	case "$src" in
		http://*|https://*)
			info "下载 $src"
			# GitHub 在部分线路上下载 1.2 GB 会被中途掐断（实测 curl: (35) TLS ...
			# unexpected eof while reading）。因此：--retry-all-errors 覆盖 TLS/传输错误，
			# -C - 让重试续传而不是从头再来（文件已存在时从断点接着写）。
			curl -fL --progress-bar --retry 5 --retry-delay 3 --retry-all-errors \
				-C - -o "$tmp" "$src" \
				|| die "下载失败（重跑同一条命令会续传）"
			;;
		*)
			[ -f "$src" ] || die "文件不存在：$src"
			info "复制本地镜像"
			cp "$src" "$tmp"
			;;
	esac
	check_squashfs "$tmp"

	image_has_tools "$tmp"
	case $? in
	0) ok "镜像自带 image-mode 工具（k50-image/pivot）" ;;
	1)
		warn "镜像里没有 /usr/local/sbin/k50-image（image-mode 工具）"
		echo "    换上去之后无法在新系统里用 k50-image 切回；只能手工改符号链接："
		echo "      sudo ln -sfn <旧镜像> $CURRENT.tmp && sudo mv -Tf $CURRENT.tmp $CURRENT && sudo reboot"
		;;
	*) warn "没有 unsquashfs，跳过多带工具的检查" ;;
	esac

	local got; got="$(sha_of "$tmp")"
	if [ -n "$want" ] && [ "$got" != "$want" ]; then
		rm -f "$tmp"
		die "sha256 不匹配：期望 $want，实际 $got"
	fi

	local ts dst
	ts="$(date -u '+%Y%m%d-%H%M%S')"
	dst="$IMAGES/system-$ts.squashfs"
	mv "$tmp" "$dst"
	printf '%s  %s\n' "$got" "$(basename "$dst")" >"$dst.sha256"
	ok "已装入 $(basename "$dst")（$(human "$(stat -c%s "$dst")")，sha256 ${got:0:16}…）"
	echo "   切换： sudo k50-image activate $(basename "$dst")"
	echo "   然后： sudo reboot"
}

# 换下层之前，把"属于这台机器、用户配置出来的东西"搬进可写层 $UPPER。
# 不搬的话它们只存在于当前下层（或首开时的引导层）里，一旦换成新镜像就消失。
# 真机实测：刷机时预置的 Wi-Fi 连接就在引导层上，activate 之后 Wi-Fi 直接没了。
# 只搬 NetworkManager 的连接配置（Wi-Fi/热点口令），这类东西本来就该跟着人走，
# 而任何镜像都不应该内置别人的 SSID 口令。
promote_stateful_config() {
	local src=/etc/NetworkManager/system-connections
	[ -d "$src" ] || return 0
	[ -d "$UPPER" ] || return 0
	local dst="$UPPER/etc/NetworkManager/system-connections"
	local n=0 f
	shopt -s nullglob
	for f in "$src"/*.nmconnection; do
		[ -f "$f" ] || continue
		mkdir -p "$dst" 2>/dev/null || continue
		cp -f "$f" "$dst/" 2>/dev/null || continue
		chown root:root "$dst/$(basename "$f")" 2>/dev/null || true
		chmod 600 "$dst/$(basename "$f")" 2>/dev/null || true
		n=$((n + 1))
	done
	shopt -u nullglob
	if [ "$n" -gt 0 ]; then
		ok "已把 $n 个网络配置（Wi-Fi/热点）搬进可写层，换镜像后仍然连得上"
	fi
	return 0
}

cmd_activate() {
	need_root activate
	local force=0 name=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--force) force=1; shift ;;
		*) name="$1"; shift ;;
		esac
	done
	[ -n "$name" ] || die "用法：k50-image activate <镜像名|文件名|全部路径> [--force]"
	[ -d "$IMAGES" ] || die "$IMAGES 不存在"
	local target
	if [ -f "$name" ]; then
		target="$name"
	elif [ -f "$IMAGES/$name" ]; then
		target="$IMAGES/$name"
	elif [ -f "$IMAGES/system-$name.squashfs" ]; then
		target="$IMAGES/system-$name.squashfs"
	elif [ -f "$IMAGES/$name.squashfs" ]; then
		target="$IMAGES/$name.squashfs"
	else
		die "找不到镜像：$name（用 k50-image list 看有哪些）"
	fi
	check_squashfs "$target"

	image_has_tools "$target"
	case $? in
	0) : ;;
	1)
		warn "这个镜像里没有 /usr/local/sbin/k50-image（image-mode 工具）"
		echo "    切换后新系统里没有 k50-image，切回旧镜像只能手工改符号链接："
		echo "      sudo ln -sfn <旧镜像> $CURRENT.tmp && sudo mv -Tf $CURRENT.tmp $CURRENT && sudo reboot"
		[ "$force" = 1 ] || die "已中止（确实要切请加 --force）"
		;;
	*) warn "没有 unsquashfs，无法检查镜像是否带 image-mode 工具（继续）" ;;
	esac

	promote_stateful_config

	local rel
	case "$target" in
		"$IMAGES"/*) rel="$(basename "$target")" ;;
		*) rel="$target" ;;
	esac
	ln -sfn "$rel" "$CURRENT.tmp"
	mv -Tf "$CURRENT.tmp" "$CURRENT"
	ok "下次启动使用 $rel"
	echo "   重启生效： sudo reboot"
	echo "   反悔：    sudo k50-image rollback && sudo reboot"
}

cmd_rollback() {
	need_root rollback
	local cur prev
	cur="$(basename "$(readlink -f "$CURRENT" 2>/dev/null || echo '')")"
	shopt -s nullglob
	local all=("$IMAGES"/system-*.squashfs)
	[ "${#all[@]}" -gt 0 ] || die "没有镜像可回滚"
	prev=""
	# 从新到旧找第一个不是当前目标的
	for ((i = ${#all[@]} - 1; i >= 0; i--)); do
		local b; b="$(basename "${all[$i]}")"
		if [ "$b" != "$cur" ]; then prev="${all[$i]}"; break; fi
	done
	[ -n "$prev" ] || die "只有一个镜像，没有可回滚的目标"
	cmd_activate "$(basename "$prev")"
}

cmd_enable() {
	need_root enable
	is_bootstrap || { ok "已经在镜像模式里跑了"; return 0; }
	[ -d "$UPPER" ] || die "可写层不存在（先跑 scripts/enable-image-mode.sh 做一次性设置）"
	[ -e "$CURRENT" ] || die "还没选镜像（k50-image activate <镜像>）"
	touch "$MARKER"
	ok "已启用：下次重启进入镜像模式"
	warn "首次启用务必确认引导层 still 可启动（不要动 ext4 根分区）"
}

cmd_disable() {
	need_root disable
	rm -f "$MARKER"
	ok "已停用：下次重启回到普通启动（ext4 根分区）"
	echo "   /data 与 /images 里的东西都还在，可以再启用"
}

cmd_prune() {
	need_root prune
	local keep="${1:-$KEEP_DEFAULT}"
	[[ "$keep" =~ ^[0-9]+$ ]] || die "保留数量得是数字"
	local cur; cur="$(basename "$(readlink -f "$CURRENT" 2>/dev/null || echo '')")"
	shopt -s nullglob
	local all=("$IMAGES"/system-*.squashfs) n=0 removed=0
	# 被引用的那个永远不删
	for ((i = ${#all[@]} - 1; i >= 0; i--)); do
		local b; b="$(basename "${all[$i]}")"
		if [ "$b" = "$cur" ]; then
			n=$((n + 1))
			continue
		fi
		n=$((n + 1))
		if [ "$n" -gt "$keep" ]; then
			rm -f "${all[$i]}" "${all[$i]}.sha256"
			ok "删除 $b"
			removed=$((removed + 1))
		fi
	done
	[ "$removed" = 0 ] && echo "  没有需要清理的（保留 $keep 个）"
	return 0
}

cmd_diff() {
	local top="${1:-30}"
	[ -d "$UPPER" ] || die "可写层不存在：$UPPER"
	echo "改动过的顶层目录（按占用排序，最多 $top 条）："
	du -sh "$UPPER"/* 2>/dev/null | sort -rh | sed -n "1,${top}p"
	echo
	printf '改动文件数：%s（overlay 只记改动，不复制整个系统）\n' "$(find "$UPPER" -type f 2>/dev/null | wc -l)"
	echo
	echo "想彻底丢掉所有改动、回到镜像原样："
	echo "  sudo k50-image reset-upper   # 会删除整个可写层，务必先备份"
}

# 把「现在跑的这套系统」打成新镜像 —— 换系统（升级/换版本）的正确姿势。
# 之所以要这条命令：日常更新应当从"自己这套系统"迭代出镜像；用别处从零构建的干净镜像
# 当系统层，会把你没改过的文件全遮住（2026-10-31 真机事故）。
cmd_snapshot() {
	need_root snapshot
	local out="${1:-}" comp="${K50_SQUASH_COMP:-gzip}"
	[ -d "$IMAGES" ] || mkdir -p "$IMAGES"
	if [ -z "$out" ]; then
		out="$IMAGES/system-$(date -u '+%Y%m%d-%H%M%S').squashfs"
	else
		case "$out" in /*) : ;; *) out="$IMAGES/$out" ;; esac
	fi
	[ -e "$out" ] && die "$out 已存在"

	command -v mksquashfs >/dev/null 2>&1 || die "需要 squashfs-tools（apt install squashfs-tools）"

	# 排除一切挂载点与易变目录，否则会把"当前的只读层"再套一层打进新镜像
	local ex=() p
	for p in /proc /sys /dev /run /tmp /mnt /images /data \
		/var/tmp /var/cache/apt /var/lib/apt/lists \
		/var/lib/k50/ro /var/lib/k50/new \
		/var/log/journal /var/log/wtmp /var/log/lastlog /var/log/btmp /swapfile \
		/root/k50rf-work /root/k50rf-test; do
		[ -e "$p" ] && ex+=("$p")
	done
	info "从当前系统打快照（压缩 ${comp}）"
	echo "  排除：${ex[*]}"
	echo "  输出：$out"
	mksquashfs / "$out" -comp "$comp" -noappend -no-progress -e "${ex[@]}" \
		|| { rm -f "$out"; die "mksquashfs 失败"; }
	sha_of "$out" >"$out.sha256"
	ok "已生成 $(basename "$out")（$(human "$(stat -c%s "$out")")）"
	if [ "$comp" = gzip ]; then
		echo "   切换： sudo k50-image activate $(basename "$out") && sudo reboot"
	else
		warn "压缩用的是 $comp —— 只有内核编进了对应 CONFIG_SQUASHFS_* 才能挂载"
	fi
}

cmd_reset_upper() {	need_root reset-upper
	is_bootstrap || die "不能在镜像模式下重置自己正在用的可写层（先在引导层/救援模式里做）"
	[ -d "$UPPER" ] || { ok "可写层本来就没有"; return 0; }
	read -r -p "确认删除 $UPPER 里的全部改动？输入 yes 继续： " a
	[ "$a" = yes ] || die "已取消"
	local bak
	bak="$DATA/upper-backup-$(date -u '+%Y%m%d-%H%M%S')"
	mv "$UPPER" "$bak"
	mkdir -p "$UPPER" "$WORK"
	ok "已重置（旧的可写层留在 $bak，确认没问题后可删）"
}

usage() {
	cat <<EOF
k50-image —— 镜像模式（只读系统层 + 可写 overlay）管理

  status                     看当前状态（默认）
  list                       列出本机镜像
  install <文件|URL> [--sha256 H]   装入新镜像
  activate <镜像> [--force]  下次启动切到这个镜像（原子操作；镜像不带 k50-image 时需 --force）
  rollback                   切回上一个镜像
  enable / disable           打开/关闭镜像模式（下次重启生效）
  prune [N]                  只保留最新 N 个镜像（默认 $KEEP_DEFAULT，被引用的不删）
  diff [N]                   看可写层里改了哪些顶层目录
  snapshot [文件名]          把"现在跑的这套系统"打成新镜像（日常更新的正确姿势）
  reset-upper                丢掉全部改动（只在引导层可用，先备份）

  典型更新流程：
    scp <新镜像>.squashfs k50:/tmp/
    ssh k50 "sudo k50-image install /tmp/xxx.squashfs"
    ssh k50 "sudo k50-image activate system-<时间戳> && sudo reboot"
    起不来就： k50-image rollback && reboot（旧系统原封不动，数据一个字节没动）
EOF
}

case "${1:-status}" in
	status) cmd_status ;;
	list) cmd_list ;;
	install) shift; cmd_install "$@" ;;
	activate) shift; cmd_activate "$@" ;;
	rollback) cmd_rollback ;;
	enable) cmd_enable ;;
	disable) cmd_disable ;;
	prune) shift; cmd_prune "$@" ;;
	diff) shift; cmd_diff "$@" ;;
	reset-upper) cmd_reset_upper ;;
	snapshot) shift; cmd_snapshot "$@" ;;
	-h | --help | help) usage ;;
	*) usage; exit 1 ;;
esac
